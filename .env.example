# ---------------------------------------------------------------------------
# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=0000000000:PLACEHOLDER_REPLACE_ME

# Telegram ID владельцев через запятую. Владельца нельзя удалить из админки.
# Свой ID можно узнать у @userinfobot
OWNER_IDS=000000000

# --- База данных ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=shopbot
DB_PASSWORD=PLACEHOLDER_REPLACE_ME
DB_NAME=shopbot

# --- Redis ------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# --- Platega ----------------------------------------------------------------
# Выдаёт менеджер при подключении. Тестовые и боевые ключи разные.
PLATEGA_ENABLED=false
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=PLACEHOLDER_REPLACE_ME
PLATEGA_SECRET=PLACEHOLDER_REPLACE_ME
# Методы оплаты, доступные покупателю, через запятую.
# 2=СБП QR, 3=ЕРИП, 11=карты, 12=международные, 13=крипта, 14=SberPay
PLATEGA_METHODS=2,11
# Куда Platega вернёт покупателя после оплаты / отказа
PLATEGA_RETURN_URL=https://t.me/your_bot
PLATEGA_FAILED_URL=https://t.me/your_bot

# --- CryptoBot --------------------------------------------------------------
CRYPTOBOT_ENABLED=false
# Боевой: https://pay.crypt.bot/api  Тестовый: https://testnet-pay.crypt.bot/api
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api
CRYPTOBOT_TOKEN=PLACEHOLDER_REPLACE_ME

# --- Приём callback'ов ------------------------------------------------------
# false — статус платежа проверяется поллером и кнопкой «Проверить оплату».
#         Годится для разработки без домена.
# true  — поднимается HTTP-сервер и принимает callback'и провайдеров.
#         Нужен публичный HTTPS с валидным сертификатом (требование Platega).
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный адрес без завершающего слэша, например https://shop.example.com
WEBHOOK_PUBLIC_URL=
# Часть пути в адресе callback'а — чтобы адрес нельзя было угадать.
# Придумать длинную случайную строку.
WEBHOOK_SECRET_PATH=PLACEHOLDER_REPLACE_ME

# --- Правила магазина -------------------------------------------------------
# Сколько минут держится резерв позиций склада во время оплаты
ORDER_RESERVE_MINUTES=20
# Максимум штук одного товара в одном заказе
MAX_QTY_PER_ORDER=10
# Сколько минут кешируется положительный результат проверки подписки
SUBSCRIPTION_CACHE_SECONDS=300
# Скорость рассылки, сообщений в секунду
BROADCAST_RATE=20

# --- Логи -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
